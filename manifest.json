{
  "manifest_version": 3,
  "name": "IRCTC Tatkal Auto Booking",
  "version": "1.0.9",
  "description": "Auto Tatkal ticket booking assistant for IRCTC with saved journey and passenger details.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://www.irctc.co.in/*",
    "https://www.irctcipay.com/*",
    "https://pg.irctcpayments.com/*",
    "https://mercury-t2.phonepe.com/*",
    "https://mercury.phonepe.com/*",
    "https://api.railticket.tool.mridev.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IRCTC Tatkal Auto Booking",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/eticket/*",
        "https://www.irctc.co.in/nget/*"
      ],
      "js": ["sites/registry.js", "lib/wait.js", "lib/modals.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.irctc.co.in/eticket/*",
        "https://www.irctc.co.in/nget/*"
      ],
      "js": [
        "packages/core/dist/chrome-core.iife.js",
        "packages/core/dist/extension-bot.iife.js",
        "overlay/paymentReview.js"
      ],
      "css": ["overlay/overlay.css", "overlay/paymentReview.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.irctcipay.com/*",
        "https://pg.irctcpayments.com/*",
        "https://mercury-t2.phonepe.com/*",
        "https://mercury.phonepe.com/*"
      ],
      "js": [
        "packages/core/dist/chrome-core.iife.js",
        "packages/core/dist/extension-gateway.iife.js"
      ],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
