{
  "manifest_version": 3,
  "name": "IRCTC Tatkal Auto Booking",
  "version": "1.0.9",
  "description": "Auto Tatkal ticket booking assistant for IRCTC with saved journey and passenger details.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://www.irctc.co.in/*",
    "https://www.irctcipay.com/*",
    "https://mercury-t2.phonepe.com/*",
    "https://mercury.phonepe.com/*",
    "http://localhost:3000/*",
    "https://api.yourdomain.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IRCTC Tatkal Auto Booking",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/eticket/*",
        "https://www.irctc.co.in/nget/*"
      ],
      "js": ["sites/registry.js", "lib/wait.js", "lib/modals.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.irctc.co.in/eticket/*",
        "https://www.irctc.co.in/nget/*"
      ],
      "js": [
        "sites/registry.js",
        "sites/eticket/config.js",
        "sites/eticket/paths.js",
        "sites/eticket/selectors.js",
        "sites/eticket/trainList.js",
        "sites/eticket/flows/login.js",
        "sites/eticket/flows/search.js",
        "sites/eticket/flows/booking.js",
        "sites/eticket/index.js",
        "sites/nget/config.js",
        "sites/nget/paths.js",
        "sites/nget/selectors.js",
        "sites/nget/trainList.js",
        "sites/nget/flows/login.js",
        "sites/nget/flows/search.js",
        "sites/nget/flows/booking.js",
        "sites/nget/index.js",
        "lib/wait.js",
        "lib/events.js",
        "lib/storage.js",
        "lib/accessConfig.js",
        "lib/api.js",
        "lib/stations.js",
        "lib/passengers.js",
        "lib/psgnPreferences.js",
        "lib/bkgPayment.js",
        "overlay/overlay.js",
        "overlay/paymentReview.js",
        "content_script.js"
      ],
      "css": ["overlay/overlay.css", "overlay/paymentReview.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.irctcipay.com/*",
        "https://mercury-t2.phonepe.com/*",
        "https://mercury.phonepe.com/*"
      ],
      "js": [
        "sites/eticket/selectors.js",
        "lib/wait.js",
        "lib/events.js",
        "lib/storage.js",
        "lib/bkgPayment.js",
        "lib/gateways/irctcIpay.js",
        "lib/gateways/phonepe.js",
        "lib/gateways/index.js",
        "overlay/overlay.js",
        "gateway_script.js"
      ],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
