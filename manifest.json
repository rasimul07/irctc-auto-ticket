{
  "manifest_version": 3,
  "name": "Rapid Tatkal - Free IRCTC Tatkal Auto Booking",
  "version": "1.1.8",
  "description": "Free auto Tatkal ticket booking assistant for IRCTC with saved journey & passenger autofill. 100% free up to payment.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.irctc.co.in/*",
    "https://*.ics.irctc.co.in/*",
    "https://www.irctc.co.in/*",
    "https://www.ics.irctc.co.in/*",
    "https://www.irctcipay.com/*",
    "https://pg.irctcpayments.com/*",
    "https://mercury-t2.phonepe.com/*",
    "https://mercury.phonepe.com/*",
    "https://api.railticket.tool.mridev.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Free IRCTC Tatkal Auto Booking",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.irctc.co.in/eticket/*",
        "https://*.irctc.co.in/nget/*",
        "https://*.ics.irctc.co.in/eticket/*",
        "https://*.ics.irctc.co.in/nget/*",
        "https://www.irctc.co.in/eticket/*",
        "https://www.irctc.co.in/nget/*",
        "https://www.ics.irctc.co.in/eticket/*",
        "https://www.ics.irctc.co.in/nget/*"
      ],
      "js": [
        "sites/registry.js",
        "lib/wait.js",
        "lib/modals.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.irctc.co.in/eticket/*",
        "https://*.irctc.co.in/nget/*",
        "https://*.ics.irctc.co.in/eticket/*",
        "https://*.ics.irctc.co.in/nget/*",
        "https://www.irctc.co.in/eticket/*",
        "https://www.irctc.co.in/nget/*",
        "https://www.ics.irctc.co.in/eticket/*",
        "https://www.ics.irctc.co.in/nget/*"
      ],
      "js": [
        "packages/core/dist/chrome-core.iife.js",
        "packages/core/dist/extension-bot.iife.js",
        "overlay/paymentReview.js"
      ],
      "css": [
        "overlay/overlay.css",
        "overlay/paymentReview.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.irctcipay.com/*",
        "https://pg.irctcpayments.com/*",
        "https://mercury-t2.phonepe.com/*",
        "https://mercury.phonepe.com/*"
      ],
      "js": [
        "packages/core/dist/chrome-core.iife.js",
        "packages/core/dist/extension-gateway.iife.js"
      ],
      "css": [
        "overlay/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
