{
  "name": "@rasimul07/core",
  "version": "0.1.0",
  "description": "Shared IRCTC Tatkal booking logic for Chrome extension and Ionic app",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./bot-bundle": "./dist/bot-bundle.iife.js",
    "./gateway-bundle": "./dist/gateway-bundle.iife.js",
    "./extension-bot": "./dist/extension-bot.iife.js",
    "./extension-gateway": "./dist/extension-gateway.iife.js",
    "./chrome-core": "./dist/chrome-core.iife.js",
    "./overlay.css": "./src/bot/overlay/overlay.css",
    "./theme/tokens.css": "./src/theme/tokens.css",
    "./validation/setupProgress": "./src/validation/setupProgress.js"
