PORT=3000
NODE_ENV=development
API_BASE_PATH=/api/v1

# Supabase Postgres (copy from Supabase dashboard → Connect → URI)
# URL-encode special chars in password (@ -> %40, # -> %23, etc.)
DATABASE_URL=postgresql://postgres.your-project-ref:your%40password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

FREE_TRIAL_DAYS=7
COFFEE_TOKENS_PER_MONTH=10
COFFEE_TOKEN_PERIOD_DAYS=30
COFFEE_RENEW_CRON_ENABLED=true
COFFEE_RENEW_CRON_SCHEDULE=0 0 * * *
BMC_PLAN_BASIC=Basic
BMC_PLAN_PRO=Pro
JWT_SECRET=change-me-in-production
BMC_WEBHOOK_SECRET=your-bmc-webhook-secret
CORS_ORIGIN=*
ALLOWED_CLIENT_TYPES=chrome_extension,ionic_android,ionic_ios
API_BASE_PROD=https://api.railticket.tool.mridev.in/api/v1
