PORT=3000
NODE_ENV=development
API_BASE_PATH=/api/v1

# Option A: local Postgres or RDS connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rail_ticket

# Option B: Supabase (recommended when password contains @ or other special chars)
# DB_HOST=db.xxxxx.supabase.co
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_NAME=postgres
# DB_PORT=5432
# DB_SSL=true

# Option C: Supabase via DATABASE_URL (URL-encode special chars in password, e.g. @ -> %40)
# DATABASE_URL=postgresql://postgres:your%40password@db.xxxxx.supabase.co:5432/postgres?sslmode=require

FREE_TRIAL_DAYS=7
JWT_SECRET=change-me-in-production
BMC_WEBHOOK_SECRET=your-bmc-webhook-secret
CORS_ORIGIN=*
ALLOWED_CLIENT_TYPES=chrome_extension,ionic_android
API_BASE_PROD=https://api.yourdomain.com/api/v1
